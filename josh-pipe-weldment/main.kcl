fn pipeWithScrewPlate = (plane, length, center, radius, thickness) => {
  fn pipe = (radius, thickness, length, center, plane) => {
    holeRadius = radius - thickness
    return startSketchOn(plane)
  |> circle({ center: center, radius: radius }, %)
  |> hole(circle({ center: center, radius: holeRadius }, %), %)
  |> extrude(length, %)
}
  fn screwHoles = (sg, n, plateCenter) => {
    gap = 2
    center = [plateCenter[0] + gap, plateCenter[1]]
    return circle({ center: center, radius: .375 }, sg)
  |> patternCircular2d({
       instances: n,
       center: plateCenter,
       arcDegrees: 360,
       rotateDuplicates: false
     }, %)
}

  fn screwPlate = (plane, length, center) => {
    return startSketchOn(offsetPlane(plane, length))
  // plate itself
  |> circle({ center: center, radius: 3 }, %)
  // big central hole
  |> hole(circle({
       center: center,
       radius: radius - thickness
     }, %), %)
  // small screw holes
  |> hole(screwHoles(%, 4, center), %)
  |> extrude(1, %)
}
  pipe(radius, thickness, length, center, plane)
  return screwPlate(plane, length, center)
}

fn mirror = (geo) => {
  return patternTransform(2, (id) => {
    return {rotation: { angle: 180 * id}}
  }, geo)
}

fn diamondBase = (plane, angle, length, holeRadius, height, center) => {
  smallAngle = angle
  bigAngle = 180 - smallAngle
  fn screwHole = (sk, n) => {
    return circle({
      center: [center[0] + n * length / 2, center[1]],
      radius: holeRadius
    }, sk)
  }
  base = startSketchOn(plane)
    |> startProfileAt([center[0], center[1] - (length / 2)], %)
    |> angledLine({ angle: smallAngle, length: length }, %)
    |> angledLine({ angle: bigAngle, length: length }, %)
    |> angledLine({
         angle: 180 + smallAngle,
         length: length
       }, %)
    |> angledLine({
         angle: 180 + bigAngle,
         length: length
       }, %)
    |> close(%)
    |> hole(screwHole(%, -1), %)
    |> hole(screwHole(%, 1), %)
    |> extrude(height, %)
  return base
}

radius = 1.25
thickness = 0.25
backPipeLen = 12
diamondBase(offsetPlane("XY", -10), 30, 10, 0.5, 1, [0, -backPipeLen])
back = pipeWithScrewPlate("XZ", backPipeLen, [0, 0], radius, thickness)
up = pipeWithScrewPlate("XY", 4, [0, -radius], radius, thickness)
